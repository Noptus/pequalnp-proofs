import PEqualNP.Defs
import Mathlib.Tactic.SplitIfs

namespace PEqualNP.Outside.L_meta_1634

open PEqualNP.CircuitLowerBounds

def W {n : ℕ} (gates : List Gate) (t : ℕ) (x : Fin n → Bool) : List Bool :=
  Circuit.wires ⟨gates.take t, 0⟩ (List.ofFn x)

lemma W_zero {n : ℕ} (gates : List Gate) (x : Fin n → Bool) :
    W gates 0 x = List.ofFn x := by
  simp [W, Circuit.wires]

lemma W_succ {n : ℕ} (gates : List Gate) (t : ℕ) (ht : t < gates.length)
    (x : Fin n → Bool) :
    W gates (t + 1) x = W gates t x ++
      [gates[t].op.eval (gates[t].inputs.map fun k => (W gates t x).getD k false)] := by
  unfold W Circuit.wires
  rw [List.take_add_one, List.getElem?_eq_getElem ht]
  simp only [Option.toList_some, List.foldl_append, List.foldl_cons, List.foldl_nil]

lemma W_length {n : ℕ} (gates : List Gate) (x : Fin n → Bool) :
    ∀ t : ℕ, t ≤ gates.length → (W gates t x).length = n + t := by
  intro t
  induction t with
  | zero => intro _; simp [W_zero]
  | succ t ih =>
    intro ht
    rw [W_succ gates t (by omega), List.length_append, ih (by omega)]
    simp
    omega

lemma getD_snoc (l : List Bool) (b : Bool) (k : ℕ) :
    (l ++ [b]).getD k false =
      if k < l.length then l.getD k false else if k = l.length then b else false := by
  simp only [List.getD_eq_getElem?_getD]
  split_ifs with h1 h2
  · rw [List.getElem?_append_left h1]
  · subst h2
    simp
  · rw [List.getElem?_eq_none]
    · rfl
    · simp
      omega

lemma ofFn_getD {n : ℕ} (x : Fin n → Bool) (k : ℕ) :
    (List.ofFn x).getD k false = if h : k < n then x ⟨k, h⟩ else false := by
  simp only [List.getD_eq_getElem?_getD]
  split_ifs with h
  · simp [h]
  · rw [List.getElem?_eq_none]
    · rfl
    · simp
      omega

lemma all_mono (ks : List ℕ) (f g : ℕ → Bool) (hfg : ∀ k, f k = true → g k = true) :
    (ks.map f).all id = true → (ks.map g).all id = true := by
  simp only [List.all_eq_true, List.mem_map, id]
  rintro h b ⟨k, hk, rfl⟩
  exact hfg k (h (f k) ⟨k, hk, rfl⟩)

lemma any_mono (ks : List ℕ) (f g : ℕ → Bool) (hfg : ∀ k, f k = true → g k = true) :
    (ks.map f).any id = true → (ks.map g).any id = true := by
  simp only [List.any_eq_true, List.mem_map, id]
  rintro ⟨b, ⟨k, hk, rfl⟩, hb⟩
  exact ⟨g k, ⟨k, hk, rfl⟩, hfg k hb⟩

lemma W_mono {n : ℕ} (gates : List Gate)
    (hops : ∀ g ∈ gates, g.op = GateOp.and ∨ g.op = GateOp.or)
    (x y : Fin n → Bool) (hxy : ∀ p, x p = true → y p = true) :
    ∀ t : ℕ, t ≤ gates.length →
      ∀ k, (W gates t x).getD k false = true → (W gates t y).getD k false = true := by
  intro t
  induction t with
  | zero =>
    intro _ k hk
    rw [W_zero, ofFn_getD] at hk ⊢
    split_ifs at hk ⊢ with h
    exact hxy _ hk
  | succ t ih =>
    intro ht k hk
    have htl : t < gates.length := by omega
    have ih' := ih (by omega)
    rw [W_succ gates t htl, getD_snoc] at hk ⊢
    rw [W_length gates x t (by omega)] at hk
    rw [W_length gates y t (by omega)]
    split_ifs at hk ⊢ with h1 h2
    · exact ih' k hk
    · rcases hops _ (List.getElem_mem htl) with hop | hop
      · rw [hop] at hk ⊢
        exact all_mono _ _ _ ih' hk
      · rw [hop] at hk ⊢
        exact any_mono _ _ _ ih' hk

lemma eval_eq {n : ℕ} (gates : List Gate) (w : ℕ) (x : Fin n → Bool) :
    Circuit.eval ⟨gates, w⟩ (List.ofFn x) = (W gates gates.length x).getD w false := by
  simp [Circuit.eval, W, Circuit.wires]

lemma eval_mono {n : ℕ} (gates : List Gate)
    (hops : ∀ g ∈ gates, g.op = GateOp.and ∨ g.op = GateOp.or)
    (x y : Fin n → Bool) (hxy : ∀ p, x p = true → y p = true) (w : ℕ) :
    Circuit.eval ⟨gates, w⟩ (List.ofFn x) = true →
      Circuit.eval ⟨gates, w⟩ (List.ofFn y) = true := by
  rw [eval_eq, eval_eq]
  exact W_mono gates hops x y hxy gates.length le_rfl w

lemma direction {N : ℕ} (A B : Finset (Fin N))
    (T : Fin N → Fin N → Bool) (f : (Fin N → Bool) → Bool)
    (hmono : ∀ x y : Fin N → Bool,
      (∀ v, x v = true → y v = true) → f x = true → f y = true)
    (hinter : (A ∩ B).card = 1)
    (hfalse : f (fun v : Fin N => decide (v ∉ B)) = false)
    (hcard : 2 ≤ (A.filter (fun p => f (T p) = true)).card) :
    ∃ p ∈ A \ B, ∃ v ∈ B, T p v = true := by
  classical
  have hout : ∃ p ∈ A.filter (fun p => f (T p) = true), p ∉ B := by
    by_contra h
    have hsub : A.filter (fun p => f (T p) = true) ⊆ A ∩ B := by
      intro p hp
      refine Finset.mem_inter.mpr ⟨(Finset.mem_filter.mp hp).1, ?_⟩
      by_contra hnot
      exact h ⟨p, hp, hnot⟩
    have hle := Finset.card_le_card hsub
    omega
  obtain ⟨p, hp, hpB⟩ := hout
  obtain ⟨hpA, htrue⟩ := Finset.mem_filter.mp hp
  refine ⟨p, Finset.mem_sdiff.mpr ⟨hpA, hpB⟩, ?_⟩
  by_contra hnone
  have hxy : ∀ v, T p v = true → decide (v ∉ B) = true := by
    intro v hv
    apply decide_eq_true
    intro hvB
    exact hnone ⟨v, hvB, hv⟩
  have hbad := hmono (T p) (fun v : Fin N => decide (v ∉ B)) hxy htrue
  rw [hfalse] at hbad
  cases hbad

end PEqualNP.Outside.L_meta_1634

theorem PEqualNP.Outside.L_meta_1634 :
    ∀ (q N : ℕ) (L : Fin N → Finset (Fin N)) (i0 p0 p1 : Fin N),
    3 ≤ q → N = q ^ 2 + q + 1 → (∀ i : Fin N, (L i).card = q + 1) → (∀ i j : Fin N, i ≠ j → (L i ∩ L j).card = 1) →
    (∀ p p' : Fin N, p ≠ p' → ∃ i : Fin N, p ∈ L i ∧ p' ∈ L i) →
    p0 ≠ p1 → p0 ∈ L i0 → p1 ∈ L i0 →
    ∀ T : Fin N → Fin N → Fin N → Bool,
    (∀ (t p v : Fin N), T t p v = true ↔ (v = p ∨ (p0 ∉ L t ∧ p ≠ p1 ∧ v = p0) ∨ (p0 ∈ L t ∧ p1 ∉ L t ∧ p ≠ p0 ∧ v = p1) ∨
      (p0 ∈ L t ∧ p1 ∈ L t ∧ p ≠ p0 ∧ p ≠ p1 ∧ v ∉ L t))) →
    ∀ (gates : List PEqualNP.CircuitLowerBounds.Gate),
    (∀ gt ∈ gates, (gt.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ gt.op = PEqualNP.CircuitLowerBounds.GateOp.or) ∧ gt.inputs.length ≤ 2) →
    (∀ i : Fin gates.length, 1 ≤ (gates.get i).inputs.length) →
    (∀ (i : Fin gates.length), ∀ w ∈ (gates.get i).inputs, w < N + (i : ℕ)) →
    ∀ ev : ℕ → (Fin N → Bool) → Bool, (∀ (w : ℕ) (x : Fin N → Bool), ev w x = PEqualNP.CircuitLowerBounds.Circuit.eval ⟨gates, w⟩ (List.ofFn x)) →
    ∀ (w : ℕ) (t u : Fin N), t ≠ u → ev w (fun v : Fin N => decide (v ∉ L t)) = false → ev w (fun v : Fin N => decide (v ∉ L u)) = false →
      2 ≤ ((L t).filter (fun p => ev w (T t p) = true)).card → 2 ≤ ((L u).filter (fun p => ev w (T u p) = true)).card →
      (∃ p ∈ L t \ L u, ∃ v ∈ L u, T t p v = true) ∧ (∃ p ∈ L u \ L t, ∃ v ∈ L t, T u p v = true) := by
  intro q N L i0 p0 p1 hq hN hsize hinter hjoin hpoints hp0 hp1
    T hT gates hgate hnonempty hwf ev hev w t u htu hfalseT hfalseU hcardT hcardU
  have hmono : ∀ x y : Fin N → Bool,
      (∀ v, x v = true → y v = true) → ev w x = true → ev w y = true := by
    intro x y hxy hx
    rw [hev w x] at hx
    rw [hev w y]
    exact PEqualNP.Outside.L_meta_1634.eval_mono gates
      (fun gt hgt => (hgate gt hgt).1) x y hxy w hx
  constructor
  · exact PEqualNP.Outside.L_meta_1634.direction (L t) (L u) (T t) (ev w)
      hmono (hinter t u htu) hfalseU hcardT
  · exact PEqualNP.Outside.L_meta_1634.direction (L u) (L t) (T u) (ev w)
      hmono (hinter u t htu.symm) hfalseT hcardU
